{
  "uid": "crawlrs-health",
  "title": "Crawler Health Overview",
  "tags": [
    "crawlrs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "gauge",
      "title": "Total URLs Fetched",
      "description": "Cumulative count since last process restart. Resets on rollout; for an across-deploys total, sum() over the metric and clamp to the run window.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(crawlrs_urls_fetched_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 101,
      "type": "gauge",
      "title": "Fetch Success Rate",
      "description": "fetched / (fetched + failed) over the last 5m. Red below 80%, yellow 80-95%, green ≥95%. The threshold ring shows the SLO band.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_urls_fetched_total[5m])) / clamp_min(sum(rate(crawlrs_urls_fetched_total[5m])) + sum(rate(crawlrs_urls_failed_total[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Current Crawl Rate",
      "description": "URLs/sec averaged over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_urls_fetched_total[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "URLs fetched (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_urls_fetched_total[5m]))",
          "legendFormat": "fetched/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "URLs failed (rate, by kind)",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(crawlrs_urls_failed_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "URLs skipped (rate, by reason)",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(crawlrs_urls_skipped_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pipeline latency (p50 / p95 / p99)",
      "description": "End-to-end claim through ack, per URL",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Workers active",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(crawlrs_workers_active)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 20
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "DLQ size",
      "description": "URLs with status=permanently_failed in the metadata ledger.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "max(crawlrs_dlq_size)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 20
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Robots cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_robots_cache_hits_total[5m])) / (sum(rate(crawlrs_robots_cache_hits_total[5m])) + sum(rate(crawlrs_robots_cache_misses_total[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 20
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Politeness disallow rate",
      "description": "Disallow verdicts per second (any reason).",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_politeness_check_total{decision=~\"disallow.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "colorMode": "value"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 20
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Phase throughput (URLs/sec entering each phase)",
      "description": "Per-second rate of each pipeline phase. In steady state all six lines should be roughly equal; divergence indicates short-circuits (politeness drops before fetch, parse failures before store, etc.).",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(crawlrs_pipeline_phase_seconds_count[1m]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Where does pipeline time go (mean seconds per URL, by phase)",
      "description": "Stacked area: each band is the average seconds spent in that phase per pipeline run. Total height ≈ average crawlrs_pipeline_seconds. Tallest band is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(crawlrs_pipeline_phase_seconds_sum[5m])) / sum by (phase) (rate(crawlrs_pipeline_phase_seconds_count[5m]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
