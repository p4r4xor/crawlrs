{
  "uid": "crawlrs-health",
  "title": "Crawler Health Overview",
  "tags": ["crawlrs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "URLs fetched (rate)",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum(rate(crawlrs_urls_fetched_total[5m]))",
          "legendFormat": "fetched/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "URLs failed (rate, by kind)",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum by (kind) (rate(crawlrs_urls_failed_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"stacking": {"mode": "normal"}}}
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "URLs skipped (rate, by reason)",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum by (reason) (rate(crawlrs_urls_skipped_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"stacking": {"mode": "normal"}}}
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pipeline latency (p50 / p95 / p99)",
      "description": "End-to-end claim through ack, per URL",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(crawlrs_pipeline_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Workers active",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum(crawlrs_workers_active)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}
          ]}
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 14}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "DLQ size",
      "description": "URLs with status=permanently_failed in the metadata ledger.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "max(crawlrs_dlq_size)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 100},
            {"color": "red", "value": 1000}
          ]}
        }
      },
      "options": {"colorMode": "background"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 14}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Robots cache hit rate",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum(rate(crawlrs_robots_cache_hits_total[5m])) / (sum(rate(crawlrs_robots_cache_hits_total[5m])) + sum(rate(crawlrs_robots_cache_misses_total[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.5},
            {"color": "green", "value": 0.9}
          ]}
        }
      },
      "options": {"colorMode": "background"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 14}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Politeness disallow rate",
      "description": "Disallow verdicts per second (any reason).",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum(rate(crawlrs_politeness_check_total{decision=~\"disallow.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"colorMode": "value"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 14}
    }
  ]
}
