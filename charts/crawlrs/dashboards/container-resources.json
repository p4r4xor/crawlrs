{
  "uid": "crawlrs-resources",
  "title": "Container Resources",
  "tags": [
    "crawlrs",
    "resources"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory % of limit (cAdvisor working set / limit)",
      "description": "container_memory_working_set_bytes / container_spec_memory_limit_bytes. cAdvisor's working set is what the kernel OOM killer compares against the limit, so this is the ratio that actually triggers OOMKill at 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "100 * container_memory_working_set_bytes{namespace=\"crawlrs\", container=\"crawlrs\"} / on(pod, container) container_spec_memory_limit_bytes{namespace=\"crawlrs\", container=\"crawlrs\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container RSS (cAdvisor)",
      "description": "container_memory_rss: anonymous + file pages mapped into the container. Diverges from process /proc rss when the container runs sidecars.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "container_memory_rss{namespace=\"crawlrs\", container=\"crawlrs\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Process RSS (heartbeat /proc/self/status)",
      "description": "VmRSS from /proc/self/status, scraped via the crawler's own /metrics. Should track cAdvisor RSS closely; a steady gap means the process is allocating but not touching the pages.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_process_rss_bytes",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "expr": "crawlrs_process_hwm_bytes",
          "legendFormat": "{{instance}} hwm",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Allocator fragmentation: VmData - RSS",
      "description": "Gap between what the program owns (data+stack+heap) and what's resident. A widening gap suggests the allocator is reserving address space it never returns to the OS; a narrowing gap with rising RSS suggests genuine retained allocation.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_process_data_bytes - crawlrs_process_rss_bytes",
          "legendFormat": "{{instance}} data-rss",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokio alive tasks",
      "description": "Total tasks the tokio runtime is tracking. Should plateau at workers + a few maintenance / supervisor tasks. Linear climb is the canonical signal of a leaked spawn.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_tokio_alive_tasks",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "description": "rate(container_cpu_usage_seconds_total[1m]). At the 2-core limit this maxes at 2.0; sustained at-limit CPU is a saturation signal worth correlating with pipeline latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Process threads",
      "description": "Thread count from /proc/self/status. tokio_workers is the configured pool size; this is the OS-level total. A growing gap usually means a blocking-pool task spawned and held a thread.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_process_threads",
          "legendFormat": "{{instance}} threads",
          "refId": "A"
        },
        {
          "expr": "crawlrs_tokio_workers",
          "legendFormat": "{{instance}} tokio_workers",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "/proc/self/fd entries: sockets, files, pipes, anon-inode fds. Sustained climb past steady state means a connection or file isn't being closed.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_process_fds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "OOM events (cumulative)",
      "description": "container_oom_events_total: kernel-recorded OOM kills against the cgroup. Non-zero means a pod was killed for memory; correlate with the working-set trace above.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(container_oom_events_total{namespace=\"crawlrs\", container=\"crawlrs\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Virtual address space (VmSize, VmPeak)",
      "description": "VmSize is the current virtual-memory footprint; VmPeak is the high-water mark since process start. A flat VmPeak with rising RSS means the allocator isn't requesting more address space, just touching pages it already owns. A climbing VmPeak that never settles is the address-space-leak signature.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "crawlrs_process_vsize_bytes",
          "legendFormat": "{{instance}} vsize",
          "refId": "A"
        },
        {
          "expr": "crawlrs_process_peak_bytes",
          "legendFormat": "{{instance}} peak",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk IO (bytes/sec)",
      "description": "rate(container_fs_writes_bytes_total) and rate(container_fs_reads_bytes_total). Spikes on write track Parquet/WARC rotation; sustained read activity is unusual for a write-only crawler workload.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m]))",
          "legendFormat": "{{pod}} write",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (rate(container_fs_reads_bytes_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m]))",
          "legendFormat": "{{pod}} read",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Network Traffic (bytes/sec)",
      "description": "rate(container_network_receive_bytes_total) is what the crawler pulls from the open internet; rate(container_network_transmit_bytes_total) is mostly DNS + outbound headers. A growing receive line that doesn't translate into more crawled URLs suggests either large body sizes or response amplification.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"crawlrs\"}[1m]))",
          "legendFormat": "{{pod}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"crawlrs\"}[1m]))",
          "legendFormat": "{{pod}} tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      }
    }
  ]
}
