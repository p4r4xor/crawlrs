{
  "uid": "crawlrs-frontier-storage",
  "title": "Frontier + Storage",
  "tags": ["crawlrs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pending claims by shard",
      "description": "XLEN of each consumer-group's PEL. Imbalance across shards = uneven host distribution.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "max by (shard) (crawlrs_frontier_pending_claims)",
          "legendFormat": "shard {{shard}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Claim outcomes by shard",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum by (shard, outcome) (rate(crawlrs_frontier_claim_total[5m]))",
          "legendFormat": "shard {{shard}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Frontier op latency p95 by op",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (op, le) (rate(crawlrs_frontier_call_seconds_bucket[5m])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight latency (claim → ack) p50 / p95",
      "description": "Surfaces stranded entries earlier than XAUTOCLAIM (5min threshold).",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(crawlrs_frontier_in_flight_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crawlrs_frontier_in_flight_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Submit batch size distribution",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum by (le) (rate(crawlrs_frontier_submit_batch_size_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {"calculate": false, "yAxis": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Store rotation rate by format",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "sum by (format) (rate(crawlrs_store_rotation_total[5m]))",
          "legendFormat": "{{format}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Store buffer bytes by format and shard",
      "description": "In-memory buffer per shard. Spikes near rotation triggers indicate write throughput.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "max by (format, shard) (crawlrs_store_buffer_bytes)",
          "legendFormat": "{{format}} shard {{shard}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 23}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Store write latency p95 by format",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (format, le) (rate(crawlrs_store_write_seconds_bucket[5m])))",
          "legendFormat": "{{format}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 23}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pool saturation",
      "description": "Currently-outstanding bb8 / sqlx connections. Sustained near pool max = saturation.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "targets": [
        {
          "expr": "max(crawlrs_frontier_pool_pending)",
          "legendFormat": "frontier (redis)",
          "refId": "A"
        },
        {
          "expr": "max(crawlrs_politeness_pool_pending)",
          "legendFormat": "politeness (redis)",
          "refId": "B"
        },
        {
          "expr": "max(crawlrs_metadata_pool_pending)",
          "legendFormat": "metadata (postgres)",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 30}
    }
  ]
}
