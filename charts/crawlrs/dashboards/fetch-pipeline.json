{
  "uid": "crawlrs-fetch-pipeline",
  "title": "Fetch Pipeline",
  "tags": [
    "crawlrs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Fetch responses by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(crawlrs_fetch_response_total[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fetch latency by kind (p50 / p95 / p99)",
      "description": "kind=page vs kind=robots; robots fetches dominate the head when robots TTLs roll over.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (kind, le) (rate(crawlrs_fetch_seconds_bucket[5m])))",
          "legendFormat": "{{kind}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (kind, le) (rate(crawlrs_fetch_seconds_bucket[5m])))",
          "legendFormat": "{{kind}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (kind, le) (rate(crawlrs_fetch_seconds_bucket[5m])))",
          "legendFormat": "{{kind}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "heatmap",
      "title": "Body bytes distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(crawlrs_fetch_body_bytes_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Per-host backoff distribution",
      "description": "Distribution of backoff durations applied on 429/503/transport errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(crawlrs_politeness_backoff_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Politeness check verdicts",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (decision) (rate(crawlrs_politeness_check_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backoff source attribution",
      "description": "Did backoff value come from server Retry-After hint, our exponential math, or hit max_backoff?",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(crawlrs_politeness_backoff_source_total[5m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Circuit breakers tripped (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_politeness_circuit_open_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Robots cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum(rate(crawlrs_robots_cache_hits_total[5m])) / (sum(rate(crawlrs_robots_cache_hits_total[5m])) + sum(rate(crawlrs_robots_cache_misses_total[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 22
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Parse latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crawlrs_parse_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 22
      }
    },
    {
      "id": 110,
      "type": "timeseries",
      "title": "Fetch timing breakdown (P95)",
      "description": "Per-stage P95 latency from FETCH_STAGE_SECONDS. `request` covers connect + TLS + send + headers (everything wreq did before returning); `body` covers the streaming body read; `total` is the wall-clock for sanity comparison. The split localizes whether latency lives in request setup vs body transfer.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (stage, kind, le) (rate(crawlrs_fetch_stage_seconds_bucket[5m])))",
          "legendFormat": "{{kind}} {{stage}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      }
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Average body size by content type",
      "description": "Mean body size of successful fetches, bucketed by content_type (html / non_html / unknown). Stacked-area read; the height is the per-type contribution to overall bandwidth, not a sum to compare across types.",
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "targets": [
        {
          "expr": "sum by (content_type) (rate(crawlrs_fetch_body_bytes_sum[5m])) / clamp_min(sum by (content_type) (rate(crawlrs_fetch_body_bytes_count[5m])), 1)",
          "legendFormat": "{{content_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2,
            "gradientMode": "opacity",
            "fillOpacity": 50,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    }
  ]
}
