{
  "uid": "crawlrs-resources-v2",
  "title": "Container Resources (v2)",
  "tags": ["crawlrs", "resources"],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory % of container limit",
      "description": "container_memory_working_set_bytes / container_spec_memory_limit_bytes, expressed as percent. The working set is what the kernel OOM killer compares against the limit, so this IS the curve that triggers OOMKill at 100%. Threshold-shaded: green <70%, yellow 70-85%, red >85%. If this line spends time in the red zone, raise the limit or shrink the worker pool.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 10, "w": 18, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "100 * container_memory_working_set_bytes{namespace=\"crawlrs\", container=\"crawlrs\"} / on(pod, container) container_spec_memory_limit_bytes{namespace=\"crawlrs\", container=\"crawlrs\"}", "legendFormat": "{{pod}}", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "% of memory limit", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "scheme", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "dashed"}},
          "mappings": [], "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "orange", "value": 85},
            {"color": "red", "value": 95}
          ]},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "OOM events (cumulative)",
      "description": "container_oom_events_total: kernel-recorded OOM kills against the cgroup. Non-zero means a pod was killed for memory pressure. Always correlate with the working-set chart on the left. Source: container_oom_events_total.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(container_oom_events_total{namespace=\"crawlrs\", container=\"crawlrs\"})", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 1}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RSS now",
      "description": "Current container_memory_rss (resident, anonymous + file-backed pages). The number that grows when workers hold body buffers + Parquet rows in memory. Source: container_memory_rss.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 5},
      "targets": [{"refId": "A", "expr": "max(container_memory_rss{namespace=\"crawlrs\", container=\"crawlrs\"})", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "blue", "mode": "fixed"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory residency (container vs process)",
      "description": "Three views of what's resident: cAdvisor's container_memory_rss (blue, what K8s sees), our heartbeat-scraped /proc/self/status VmRSS (light-blue, what the process self-reports), and VmData (orange, total committed data including stack + heap). Container RSS and process RSS should track each other closely. VmData growing while RSS stays flat means address space committed but pages aren't touched.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "targets": [
        {"refId": "A", "expr": "max(container_memory_rss{namespace=\"crawlrs\", container=\"crawlrs\"})", "legendFormat": "container RSS (cAdvisor)", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "B", "expr": "max(crawlrs_process_rss_bytes)", "legendFormat": "process RSS (/proc)", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "C", "expr": "max(crawlrs_process_data_bytes)", "legendFormat": "VmData (committed)", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes resident", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "decbytes"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}, {"id": "custom.lineWidth", "value": 2}, {"id": "displayName", "value": "container RSS (cAdvisor)"}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"fixedColor": "super-light-blue", "mode": "fixed"}}, {"id": "displayName", "value": "process RSS (/proc)"}]},
          {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}, {"id": "displayName", "value": "VmData (committed)"}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Allocator fragmentation (VmData - RSS)",
      "description": "Bytes the process has committed to address space but the OS hasn't kept resident. A widening gap means the allocator is holding pages it never returns to the kernel; a narrowing gap with rising RSS means genuine allocation growth. Watch this when you suspect a fragmentation problem rather than a leak.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "targets": [{"refId": "A", "expr": "max(crawlrs_process_data_bytes - crawlrs_process_rss_bytes)", "legendFormat": "VmData - RSS", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes (non-resident, committed)", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 30, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "decbytes"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Virtual address space (VmSize / VmPeak)",
      "description": "VmSize = current virtual-memory footprint (everything the process has reserved, resident or not). VmPeak = high-water mark since process start. A flat VmPeak with rising RSS means the allocator isn't requesting more address space, just touching what it owns. A climbing VmPeak that never settles is the classic address-space leak signature.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "targets": [
        {"refId": "A", "expr": "max(crawlrs_process_vsize_bytes)", "legendFormat": "VmSize", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "B", "expr": "max(crawlrs_process_peak_bytes)", "legendFormat": "VmPeak", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes (virtual)", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "decbytes"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}, {"id": "displayName", "value": "VmSize (current)"}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}, {"id": "custom.lineWidth", "value": 2}, {"id": "displayName", "value": "VmPeak (high-water mark)"}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "description": "rate(container_cpu_usage_seconds_total[1m]). At the local-deploy 2-core limit this maxes at 2.0; sustained at-limit CPU is the saturation signal worth correlating with pipeline latency. Threshold lines mark common limits.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m]))", "legendFormat": "{{pod}}", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "cores", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "dashed"}},
          "decimals": 2, "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1.0},
            {"color": "orange", "value": 1.5},
            {"color": "red", "value": 1.9}
          ]},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokio alive tasks",
      "description": "Total tasks the tokio runtime is tracking. Should plateau roughly at `workers + supervisor + maintenance`. A linear climb is the canonical signal of a leaked spawn (a task being created but never completed or cancelled). Source: crawlrs_tokio_alive_tasks.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "targets": [{"refId": "A", "expr": "max(crawlrs_tokio_alive_tasks)", "legendFormat": "alive tasks", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "tasks", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "OS threads vs tokio workers",
      "description": "process_threads (from /proc/self/status) is the OS-level total. tokio_workers is the configured async runtime pool size. The natural gap is `tokio_workers + supervisor + a few blocking-pool threads`. A widening gap means a blocking-pool task spawned and held a thread (or there's a leak in spawn_blocking calls). Source: crawlrs_process_threads, crawlrs_tokio_workers.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
      "targets": [
        {"refId": "A", "expr": "max(crawlrs_process_threads)", "legendFormat": "OS threads", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "B", "expr": "max(crawlrs_tokio_workers)", "legendFormat": "tokio workers", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "threads", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}, {"id": "custom.lineWidth", "value": 2}, {"id": "displayName", "value": "OS threads"}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}, {"id": "displayName", "value": "tokio workers"}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "/proc/self/fd entries: sockets, files, pipes, anon-inodes. Sustained climb past steady state means a connection or file isn't being closed (typically TCP sockets piling up because keep-alive pooling is wrong, or a file handle leak in a writer). Source: crawlrs_process_fds.",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
      "targets": [{"refId": "A", "expr": "max(crawlrs_process_fds)", "legendFormat": "open FDs", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "FDs open", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk IO (read / write)",
      "description": "Container-level filesystem read + write throughput. Write spikes coincide with Parquet/WARC rotations; sustained read is unusual for a write-only crawler workload (would indicate something is paging from disk). Source: rate(container_fs_writes_bytes_total[1m]) and rate(container_fs_reads_bytes_total[1m]).",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42},
      "targets": [
        {"refId": "A", "expr": "sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m]))", "legendFormat": "write", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "B", "expr": "sum by (pod) (rate(container_fs_reads_bytes_total{namespace=\"crawlrs\", container=\"crawlrs\"}[1m]))", "legendFormat": "read", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes/sec", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "Bps"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}, {"id": "custom.lineWidth", "value": 2}, {"id": "displayName", "value": "write"}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}, {"id": "displayName", "value": "read"}]}
        ]
      },
      "options": {"legend": {"calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Network traffic (rx / tx)",
      "description": "Pod-level network throughput. rx = bytes received from the open internet (HTML bodies + DNS responses). tx = bytes transmitted (HTTP requests + DNS queries). rx growing without translation into more crawled URLs suggests large body sizes or response amplification; check the body-size percentile panel on Crawler Health. Source: rate(container_network_*_bytes_total[1m]).",
      "datasource": {"type": "prometheus", "uid": "crawlrs-vm"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42},
      "targets": [
        {"refId": "A", "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"crawlrs\"}[1m]))", "legendFormat": "rx", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}},
        {"refId": "B", "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"crawlrs\"}[1m]))", "legendFormat": "tx", "datasource": {"type": "prometheus", "uid": "crawlrs-vm"}}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes/sec", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}},
          "mappings": [], "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "unit": "Bps"
        },
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}, {"id": "custom.lineWidth", "value": 2}, {"id": "displayName", "value": "rx (in)"}]},
