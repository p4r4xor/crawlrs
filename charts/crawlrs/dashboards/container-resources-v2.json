    {
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "description": "container_memory_working_set_bytes / container_spec_memory_limit_bytes, expressed as percent. The working set is what the kernel OOM killer compares against the limit, so this IS the curve that triggers OOMKill at 100%. Threshold-shaded: green <70%, yellow 70-85%, red >85%. If this line spends time in the red zone, raise the limit or shrink the worker pool.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "% of memory limit",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "last"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crawlrs-vm"
          },
          "expr": "100 * container_memory_working_set_bytes{namespace=\"crawlrs\", container=\"crawlrs\"} / on(pod, container) container_spec_memory_limit_bytes{namespace=\"crawlrs\", container=\"crawlrs\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Memory % of container limit",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "description": "container_oom_events_total: kernel-recorded OOM kills against the cgroup. Wrapped in max_over_time(...[1h]) so OOM events that fired in a previous container generation (which get reset to 0 on container restart) still show up here. Non-zero means a pod was killed for memory pressure in the last hour. Correlate with the working-set chart on the left. Source: max_over_time(container_oom_events_total[1h]).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
