    {
      "datasource": {
        "type": "prometheus",
        "uid": "crawlrs-vm"
      },
      "description": "process_threads (from /proc/self/status) is the OS-level total. tokio_workers is the configured async runtime pool size. The natural gap is `tokio_workers + supervisor + a few blocking-pool threads`. A widening gap means a blocking-pool task spawned and held a thread (or there's a leak in spawn_blocking calls). Source: crawlrs_process_threads, crawlrs_tokio_workers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
